---
import { site } from '../data/site';
import ExternalLink from './ExternalLink.astro';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { name: 'Products', href: '/products/', active: path.startsWith('/products') },
  { name: 'Engineering', href: '/engineering/', active: path.startsWith('/engineering') },
  { name: 'Network', href: '/network/', active: path.startsWith('/network') },
  { name: 'About', href: '/about/', active: path.startsWith('/about') },
  { name: 'Writing', href: '/writing/', active: path.startsWith('/writing') },
];
---
<header class:list={["site-header", { "hero-header": overlay }]} data-hero-header={overlay ? '' : undefined}>
  <div class="container header-inner">
    <a class="home-link" href="/">Mehmet Arslanca</a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.name}</a>)}
    </nav>
    <div class="header-socials desktop-socials">
      {site.socials.slice(0, 2).map((link) => <ExternalLink href={link.href}>{link.name}</ExternalLink>)}
    </div>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <div class="mobile-panel">
        <nav aria-label="Mobile navigation">{links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.name}</a>)}</nav>
        <div class="header-socials">{site.socials.slice(0, 2).map((link) => <ExternalLink href={link.href}>{link.name}</ExternalLink>)}</div>
      </div>
    </details>
  </div>
</header>
<style>
  .site-header {
    --header-bg: rgb(10 10 10 / .88);
    --header-text: var(--text);
    --header-muted: var(--text-muted);
    --header-line: rgb(231 227 222 / .08);
    position: sticky;
    z-index: 40;
    top: 0;
    color: var(--header-text);
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-line);
    backdrop-filter: blur(14px);
    transition: color 220ms ease, background-color 220ms ease, border-color 220ms ease;
  }
  .hero-header { position: fixed; inset: 0 0 auto; --header-bg: rgb(10 10 10 / .32); --header-muted: #c8c1bb; }
  :global(html[data-light-surface]) .site-header {
    --header-bg: rgb(229 224 218 / .9);
    --header-text: var(--light-band-text);
    --header-muted: var(--light-muted);
    --header-line: rgb(17 16 15 / .1);
  }
  :global(.js:not(.intro-ready)) .hero-header { opacity: 0; transform: translate3d(0, -10px, 0); }
  :global(.js.intro-ready) .hero-header { opacity: 1; transform: translate3d(0, 0, 0); transition: opacity 650ms 120ms cubic-bezier(.22, 1, .36, 1), transform 650ms 120ms cubic-bezier(.22, 1, .36, 1); }
  .header-inner { min-height: 90px; display: grid; grid-template-columns: minmax(9rem, 1fr) auto minmax(9rem, 1fr); align-items: center; gap: 2rem; }
  .home-link { display: inline-flex; align-items: center; width: fit-content; min-height: 44px; font-size: .8rem; color: var(--header-muted); }
  nav, .header-socials { display: flex; gap: clamp(1rem, 2vw, 2rem); }
  nav a, .header-socials :global(a) { display: inline-flex; align-items: center; min-height: 44px; font-size: .85rem; }
  nav a { border-bottom: 1px solid transparent; }
  nav a:hover, nav a[aria-current] { border-color: var(--accent-soft); }
  .header-socials { justify-self: end; color: var(--header-muted); }
  .mobile-menu { display: none; }
  @media (max-width: 980px) {
    .header-inner { min-height: 76px; grid-template-columns: 1fr auto; gap: 1rem; }
    .desktop-nav, .desktop-socials { display: none; }
    .mobile-menu { position: relative; display: block; justify-self: end; }
    summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-size: .8rem; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    .mobile-panel { position: absolute; top: calc(100% + .5rem); right: 0; width: min(17rem, calc(100vw - (2 * var(--gutter)))); padding: 1rem 1.25rem; color: var(--header-text); background: var(--header-bg); border: 1px solid var(--header-line); box-shadow: 0 1rem 2.5rem rgb(0 0 0 / .22); backdrop-filter: blur(16px); }
    .mobile-panel nav, .mobile-panel .header-socials { display: grid; gap: .1rem; justify-items: start; }
    .mobile-panel .header-socials { margin-top: .75rem; padding-top: .75rem; border-top: 1px solid var(--line); }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header { --header-bg: #0a0a0a; backdrop-filter: none; }
    :global(html[data-light-surface]) .site-header { --header-bg: #e5e0da; }
  }
</style>
