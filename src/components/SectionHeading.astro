---
interface Props { title: string; note?: string }
const { title, note } = Astro.props;
---
<div class="section-heading" data-scroll-reveal><h2>{title}</h2>{note && <p class="label">{note}</p>}</div>
<style>
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2.75rem; }
  h2 { font-size: clamp(1.5rem, 2.5vw, 2.15rem); } p { margin: 0; text-align: right; }
  @media (max-width: 600px) { .section-heading { display: block; margin-bottom: 2rem; } p { text-align: left; margin-top: .75rem; } }
</style>
