---
export interface RailSection { id: string; title: string; target?: string }
interface Props { sections: RailSection[] }
const { sections } = Astro.props;
---

<nav class="section-rail" aria-label="Homepage sections" data-section-rail>
  <ol>
    {sections.map((section, index) => (
      <li>
        <a
          href={`#${section.target ?? section.id}`}
          aria-label={`Go to ${section.title}`}
          aria-current={index === 0 ? 'location' : undefined}
          data-section-rail-link
          data-section-rail-target={section.id}
        >
          <span class="section-preview" aria-hidden="true">
            <span class="section-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="section-title">{section.title}</span>
          </span>
          <span class="section-tick" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .section-rail {
    --rail-muted: rgb(231 227 222 / .34);
    --rail-active: rgb(231 227 222 / .92);
    position: fixed;
    z-index: 20;
    top: 50%;
    right: clamp(.35rem, .8vw, .85rem);
    width: 2.25rem;
    transform: translateY(-50%);
  }
  :global(html[data-light-surface]) .section-rail {
    --rail-muted: rgb(17 16 15 / .36);
    --rail-active: rgb(17 16 15 / .9);
  }
  ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  a { position: relative; display: flex; width: 100%; height: 1.25rem; align-items: center; justify-content: flex-end; color: inherit; }
  .section-tick { width: .5rem; height: 1px; background: var(--rail-muted); transition: width 180ms var(--ease), background-color 220ms ease, opacity 220ms ease; }
  a[aria-current='location'] .section-tick { width: 1.45rem; height: 2px; background: var(--rail-active); }
  a:hover .section-tick, a:focus-visible .section-tick { width: 1.7rem; background: var(--rail-active); }
  a:focus-visible { outline: none; }
  a:focus-visible .section-tick { box-shadow: 0 0 0 1px var(--rail-active); }
  .section-preview {
    position: absolute;
    top: 50%;
    right: calc(100% + .6rem);
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: .65rem;
    width: max-content;
    max-width: 12rem;
    padding: .65rem .75rem;
    border: 1px solid rgb(231 227 222 / .12);
    background: rgb(10 10 10 / .94);
    color: var(--text);
    box-shadow: 0 .6rem 2rem rgb(0 0 0 / .2);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(.35rem, -50%, 0);
    transition: opacity 140ms ease, transform 140ms ease, visibility 0s linear 140ms;
  }
  a:hover .section-preview, a:focus-visible .section-preview {
    opacity: 1;
    visibility: visible;
    transform: translate3d(0, -50%, 0);
    transition-delay: 0s;
  }
  .section-number { padding-top: .15rem; font-family: var(--font-mono); color: var(--text-muted); font-size: .5625rem; line-height: 1.3; }
  .section-title { font-family: var(--font-display); font-size: .9rem; line-height: 1.15; }

  @media (max-width: 1023px), (max-height: 599px) {
    .section-rail { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .section-tick, .section-preview { transition: none; }
  }
</style>
