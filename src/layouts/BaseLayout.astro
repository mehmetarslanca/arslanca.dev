---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter-tight/latin-500.css';
import '@fontsource/inter-tight/latin-ext-500.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; article?: boolean; published?: Date }
const { title = `${site.name} | ${site.role}`, description = site.description, noindex = false, article = false, published } = Astro.props;
const canonicalPath = /^\/404\/?$/.test(Astro.url.pathname) ? '/404.html' : Astro.url.pathname;
const canonical = new URL(canonicalPath, site.url).href;
const socialImage = new URL('/images/social.png', site.url).href;
const code = import.meta.env.PUBLIC_GOATCOUNTER_CODE?.trim();
const analytics = import.meta.env.PROD && code && /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(code) ? `https://${code}.goatcounter.com/count` : undefined;
const structuredData = { '@context': 'https://schema.org', '@type': 'Person', name: site.name, url: site.url, sameAs: site.socials.filter((link) => link.href.startsWith('https:')).map((link) => link.href) };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="arslanca.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mehmet Arslanca, Software Engineer, arslanca.dev" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Mehmet Arslanca, Software Engineer, arslanca.dev" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {analytics && <script is:inline data-goatcounter={analytics} async src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <div class="surface-wash" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={Astro.url.pathname === '/'} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import '../scripts/scroll-motion';
    </script>
  </body>
</html>
