---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRail from '../components/SectionRail.astro';
import StatusTag from '../components/StatusTag.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { selectedProjects } from '../data/projects';
import { currently } from '../data/site';
const edip = selectedProjects.find((project) => project.slug === 'edip')!;
const over = selectedProjects.find((project) => project.slug === 'its-so-over')!;
const rail = [{ id: 'hero', title: 'Hero' }, { id: 'care', title: 'What I Care About' }, { id: 'currently', title: 'Currently' }, { id: 'working-on', title: 'Working On' }, { id: 'environment', title: 'Environment' }, { id: 'about-home', title: 'About' }];
const careIdeas = [
  { title: 'Products are for people.', copy: 'A feature working according to specification is only part of the job. The details at the edges, how failure is explained, and whether the next step is understandable are engineering concerns.' },
  { title: 'Complexity has to justify itself.', copy: 'Architecture matters because responsibilities, state, and behavior need protection. I accept complexity when the problem earns it and the product receives something valuable in return.' },
  { title: 'Software is reality, reflected.', copy: 'Coding is fundamentally an art of laziness: an obsession with never repeating yourself tomorrow. If you despise redundancy enough, you’ve got what it takes to build software.' },
];
const environment = [
  { label: 'System', value: 'CachyOS / KDE Plasma / Wayland' },
  { label: 'Machine', value: 'Ryzen 5 5500 / RTX 3060 12 GB / 16 GB RAM' },
  { label: 'Languages', value: 'Java / Kotlin / Rust' },
  { label: 'Domains', value: 'Android / Spring / Linux' },
];
---
<BaseLayout>
  <SectionRail sections={rail} />
  <section id="hero" class="hero" aria-labelledby="identity" data-hero data-section-anchor>
    <div class="hero-background" aria-hidden="true"><img src="/images/onboard.png" alt="" width="1672" height="941" fetchpriority="high" decoding="async" /></div><div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content container"><div class="hero-identity"><h1 id="identity" class="hero-intro-piece" data-hero-intro style="--intro-delay:170ms">Mehmet Arslanca</h1><p class="hero-intro-piece" data-hero-intro style="--intro-delay:260ms">Software Engineer</p></div><p class="hero-manifesto"><span class="manifesto-line hero-intro-piece" data-hero-intro style="--intro-delay:350ms">Making software that actually matters</span><span class="manifesto-line hero-intro-piece muted-line" data-hero-intro style="--intro-delay:450ms">to the person behind the screen.</span></p><div class="hero-bottom"><p class="label signature hero-intro-piece" data-hero-intro style="--intro-delay:550ms">Software development at it's peak.<br />If you only do it correctly.</p><p class="hero-support hero-intro-piece" data-hero-intro style="--intro-delay:630ms">It’s always in the margins. The friction, the failure states, the silent demands on the user. Tools accelerate shipping. They don’t give a damn about the human waiting on the other end.</p></div></div>
  </section>
  <section id="care" class="section container care" aria-labelledby="care-heading" data-section-anchor><div class="section-heading" data-scroll-reveal><p class="label">What guides the work</p><div><h2 id="care-heading">What I care about</h2><p>Good software starts before implementation and remains accountable after it works.</p></div></div><ol class="care-list">{careIdeas.map((idea, index) => <li data-scroll-reveal data-motion-lag={String(index * .025)}><span class="label">{String(index + 1).padStart(2, '0')}</span><h3>{idea.title}</h3><p>{idea.copy}</p></li>)}</ol></section>
  <section id="currently" class="section container currently" aria-labelledby="currently-heading" data-section-anchor><div data-scroll-reveal><p class="label">A living snapshot</p><h2 id="currently-heading">Currently</h2></div><dl>{currently.map((item, index) => <div data-scroll-reveal data-motion-lag={String(index * .02)}><dt class="label">{item.label}</dt><dd>{item.href ? item.href.startsWith('http') ? <ExternalLink href={item.href}>{item.value}</ExternalLink> : <a href={item.href}>{item.value}<span class="arrow" aria-hidden="true">→</span></a> : item.value}</dd></div>)}</dl></section>
  <section id="working-on" class="section container working" aria-labelledby="working-heading" data-section-anchor><div class="section-heading" data-scroll-reveal><p class="label">Currently working on</p><div><h2 id="working-heading">Two products,<br />two contexts.</h2><p>Personal work and shared work each carry different responsibilities.</p></div></div><div class="project-previews"><article data-scroll-reveal><div class="project-meta"><StatusTag ownership={edip.ownership} status={edip.status} /><span class="label">Personal</span></div><h3>EDIP</h3><p>An AI-oriented video editor for creators, built around local ownership, conversational revision, and non-destructive work.</p><a class="text-link" href="/products/edip/">Explore EDIP <span class="arrow" aria-hidden="true">→</span></a></article><article data-scroll-reveal data-motion-lag="0.04"><div class="project-meta"><StatusTag ownership={over.ownership} status={over.status} /><span class="label">Shared product</span></div><h3>IT’S SO OVER</h3><p>A local-only Android product that turns observable device behavior into timely reality checks. IT’S SO OVER uses on-device behavioral context and curated content to decide when a nudge is actually worth making.</p><p>The tone is dry and direct, but the target is always the behavior, never the person.</p><a class="text-link" href="/products/#its-so-over">View product context <span class="arrow" aria-hidden="true">→</span></a></article></div></section>
  <section id="environment" class="section container environment" aria-labelledby="environment-heading" data-section-anchor><div data-scroll-reveal><p class="label">Personal systems</p><h2 id="environment-heading">My environment</h2><p class="muted">The machines, systems, and domains I move through every day.</p></div><dl>{environment.map((item, index) => <div data-scroll-reveal data-motion-lag={String(index * .02)}><dt class="label">{item.label}</dt><dd>{item.value}</dd></div>)}</dl><a class="text-link" href="/engineering/#workbench">Full engineering workbench <span class="arrow" aria-hidden="true">→</span></a></section>
  <section id="about-home" class="section container about-home" aria-labelledby="about-home-heading" data-section-anchor><p class="label" data-scroll-reveal>About</p><div data-scroll-reveal><h2 id="about-home-heading">Engineer, builder,<br />person.</h2><p>I’m a software engineer from Türkiye. I move between product decisions, architecture, backend, mobile, and systems work depending on what the product actually needs.</p><a class="text-link" href="/about/">More about me <span class="arrow" aria-hidden="true">→</span></a></div></section>
</BaseLayout>
<style>
  .hero{--hero-focal-point:58% 52%;position:relative;isolation:isolate;min-height:100svh;overflow:clip;--text-muted:#c8c1bb}.hero-background,.hero-shade{position:absolute;inset:0;z-index:-1}.hero-background{--hero-bg-scale:1.045;filter:blur(3px);opacity:1;transform:translate3d(0,var(--hero-background-y,0),0) scale(var(--hero-bg-scale))}.hero-background img{width:100%;height:100%;object-fit:cover;object-position:var(--hero-focal-point)}.hero-shade{background:#0009}.hero-content{min-height:100svh;padding-block:calc(90px + clamp(2.5rem,5vh,5rem)) 3.5rem;display:flex;flex-direction:column;justify-content:space-between;gap:3rem;transform:translate3d(0,var(--hero-y,0),0);opacity:var(--hero-opacity,1)}.hero-identity h1{font-size:clamp(1.5rem,2.3vw,2rem)}.hero-identity p{color:var(--text-muted);font-size:.875rem;margin:.5rem 0 0}.hero-manifesto{font-family:var(--font-display);font-weight:500;letter-spacing:-.045em;font-size:clamp(2.3rem,5.1vw,5rem);line-height:1.08;max-width:23ch;margin:0}.manifesto-line{display:block}.muted-line{color:var(--text-muted)}.hero-bottom{display:grid;grid-template-columns:1fr 1.05fr;gap:3rem;align-items:end}.signature{border-left:2px solid var(--accent);padding-left:1rem;margin:0}.hero-support{font-size:.9rem;line-height:1.75;max-width:55ch;margin:0;color:var(--text-muted)}
  .section-heading{display:grid;grid-template-columns:minmax(10rem,.65fr) minmax(0,1.35fr);gap:clamp(3rem,8vw,9rem);margin-bottom:clamp(3rem,6vw,5rem)}.section-heading h2,.environment h2,.about-home h2{font-size:clamp(3rem,7vw,7rem);line-height:.98}.section-heading>div>p,.environment>div>p{color:var(--text-muted);max-width:46ch;margin-top:1.5rem}.care-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(2.25rem,4vw,4.5rem);list-style:none;padding:0;margin:0}.care-list h3{max-width:12ch;margin:1.25rem 0;font-size:clamp(1.8rem,2.7vw,3rem)}.care-list p{color:var(--text-muted);font-size:.875rem}.currently{display:grid;grid-template-columns:minmax(10rem,.45fr) minmax(0,1.55fr);gap:clamp(3rem,8vw,9rem)}.currently h2{margin-top:1rem;font-size:clamp(2.6rem,6vw,6rem);line-height:.98}.currently dl,.environment dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2.5rem 4rem;margin:0}dt{margin-bottom:.6rem}dd{margin:0;font-family:var(--font-display);font-size:clamp(1.2rem,2vw,1.75rem)}
  .project-previews{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,7rem)}.project-previews article{min-height:27rem;padding:clamp(2rem,4vw,4rem);background:var(--bg-elevated);display:flex;flex-direction:column;align-items:flex-start}.project-meta{width:100%;display:flex;justify-content:space-between;gap:1rem}.project-previews h3{margin:clamp(3rem,6vw,6rem) 0 1.5rem;font-size:clamp(3.5rem,7vw,7rem);line-height:.85;letter-spacing:-.07em}.project-previews p{max-width:52ch;color:var(--text-muted)}.project-previews .text-link{margin-top:auto}.environment{display:grid;grid-template-columns:.65fr 1.35fr;gap:4rem 8rem}.environment dl{align-self:end}.environment>a{grid-column:2;width:fit-content}.about-home{display:grid;grid-template-columns:.55fr 1.45fr;gap:clamp(3rem,8vw,9rem)}.about-home div{max-width:62rem}.about-home p{max-width:58ch;margin:2rem 0;color:var(--text-muted);font-size:1.1rem}
  :global(.js:not(.intro-ready)) .hero-background{--hero-bg-scale:1.07;filter:blur(7px);opacity:.52}:global(.js.intro-ready) .hero-background{--hero-bg-scale:1.045;filter:blur(3px);opacity:1;transition:opacity 1100ms cubic-bezier(.22,1,.36,1),filter 1100ms cubic-bezier(.22,1,.36,1),transform 1100ms cubic-bezier(.22,1,.36,1)}:global(.js:not(.intro-ready)) .hero-intro-piece{opacity:0;transform:translate3d(0,32px,0)}:global(.js.intro-ready) .hero-intro-piece{opacity:1;transform:none;transition:opacity 780ms var(--intro-delay) cubic-bezier(.22,1,.36,1),transform 780ms var(--intro-delay) cubic-bezier(.22,1,.36,1)}
  @media(max-width:900px){.care-list{grid-template-columns:1fr}.project-previews{grid-template-columns:1fr}.environment{grid-template-columns:1fr}.environment>a{grid-column:auto}}@media(max-width:760px){.hero{--hero-focal-point:62% center}.hero-content{padding-block:8rem 2.5rem}.hero-bottom,.section-heading,.currently,.about-home{grid-template-columns:1fr}.currently dl,.environment dl{grid-template-columns:1fr}.project-previews article{min-height:23rem}}@media(prefers-reduced-motion:reduce){.hero-background,:global(.js:not(.intro-ready)) .hero-background{--hero-bg-scale:1.045;filter:blur(3px);opacity:1}:global(.js:not(.intro-ready)) .hero-intro-piece{opacity:1;transform:none}}
</style>
