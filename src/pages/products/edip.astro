---
import WorkLayout from '../../layouts/WorkLayout.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import StatusTag from '../../components/StatusTag.astro';
import { selectedProjects } from '../../data/projects';
const edip=selectedProjects.find((p)=>p.slug==='edip')!;
const decisions=[{title:'Local-first by design',copy:'Source media, project state, edit state, transcripts, local analysis artifacts, and the render workflow remain on the user’s machine. Local project and media ownership are part of the product’s foundation.'},{title:'Non-destructive editing',copy:'The original source is preserved. AI edits and manual edits change project and output state rather than destructively rewriting source media. Trying another direction should not cost the material you started with.'},{title:'Conversation first, timeline assisted',copy:'Conversation is the primary interaction. The timeline helps inspect the output, select a scope, understand state, and review revisions without becoming a full manual NLE.'},{title:'AI plans, deterministic systems execute',copy:'AI handles editorial understanding and planning. Validated, structured decisions become deterministic media operations beneath a flexible way of expressing intent.'}];
---
<WorkLayout title="EDIP | Mehmet Arslanca" description="EDIP is Mehmet Arslanca’s personal, local-first, AI-oriented video editor built around intent, inspection, and conversational revision."><header class="page-intro" data-scroll-reveal><StatusTag ownership={edip.ownership} status={edip.status}/><h1>EDIP</h1><p class="intro-copy">Describe the video you want.<br/>Stay in control of the edit.</p><p class="muted attribution">{edip.attribution}</p></header><div data-scroll-reveal><ProductVisual visual={edip.visual}/></div><div class="essay"><div class="label essay-label">The product</div><div class="prose" data-scroll-reveal><h2>From raw footage to a considered edit.</h2><p>EDIP is a local-first, AI-oriented video editor for creators. Bring in raw footage and describe the result you want. The product analyzes and edits the material; you inspect the output, revise parts conversationally, and export when the result is right.</p><h2>Why it exists</h2><p>EDIP makes intent and revision the primary interaction. The goal is not to rebuild a traditional editor. It lets a creator express what they want, then retain enough inspection and control to decide whether the result works.</p><h2>The first result is a starting point.</h2><p>An AI edit is not sacred. Revision is a first-class workflow, grounded in local project ownership, non-destructive editing, and deterministic execution beneath AI planning.</p></div></div><section class="decisions"><h2 data-scroll-reveal>Key decisions</h2><div class="decision-grid">{decisions.map((d,i)=><article data-scroll-reveal><span class="label">{String(i+1).padStart(2,'0')}</span><h3>{d.title}</h3><p>{d.copy}</p></article>)}</div></section><div class="case-end"><a class="text-link" href="/engineering/#media">Engineering decisions <span class="arrow">→</span></a></div></WorkLayout>
<style>.page-intro{padding-top:4rem}.attribution{font-size:.875rem;margin-top:2rem}.essay{display:grid;grid-template-columns:1fr 2fr;gap:3rem;padding-block:var(--section-space)}.prose h2:first-child{margin-top:0}.prose{color:var(--text-muted)}.prose h2{color:var(--text)}.decisions{padding-bottom:var(--section-space)}.decisions>h2{font-size:2rem;margin-bottom:3rem}.decision-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem 5rem}.decision-grid article{padding-top:1rem}.decision-grid h3{font-size:1.5rem;margin-block:1rem}.decision-grid p{color:var(--text-muted)}.case-end{padding-bottom:4rem}@media(max-width:760px){.essay,.decision-grid{grid-template-columns:1fr;gap:2rem}}</style>
