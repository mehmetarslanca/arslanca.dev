---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionRail from '../../components/SectionRail.astro';
import PageHero from '../../components/PageHero.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import StatusTag from '../../components/StatusTag.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { selectedProjects, archiveProjects } from '../../data/projects';
const edip = selectedProjects.find((p) => p.slug === 'edip')!;
const over = selectedProjects.find((p) => p.slug === 'its-so-over')!;
const orchestrai = archiveProjects.find((p) => p.slug === 'orchestrai')!;
const experiments = archiveProjects.filter((p) => p.slug !== 'orchestrai');
const rail = [{id:'products-intro',title:'Intro'},{id:'personal',title:'Personal'},{id:'edip',title:'EDIP'},{id:'devonair',title:'Devonair'},{id:'its-so-over',title:"IT'S SO OVER"},{id:'ecosystem',title:'Aelova / Ripple'},{id:'orchestrai',title:'OrchestrAI'},{id:'experiments',title:'Experiments'}];
---
<BaseLayout title="Products | Mehmet Arslanca" description="Products Mehmet Arslanca builds independently and with Devonair, including EDIP, IT’S SO OVER, archived work, and experiments.">
  <SectionRail sections={rail} />
  <PageHero id="products-intro" label="Products" title="Things I build." statement="Products are decisions carried into behavior, systems, and the details people eventually depend on." image="/images/page-heroes/products.png" />
  <section id="personal" class="section container section-lead" data-section-anchor><p class="label" data-scroll-reveal>Personal products</p><h2 data-scroll-reveal>Built with direct responsibility.</h2></section>
  <section id="edip" class="section container product-feature" data-section-anchor aria-labelledby="edip-title"><div class="feature-meta" data-scroll-reveal><p class="label">Personal / In production</p><StatusTag ownership={edip.ownership} status={edip.status} /></div><h2 id="edip-title" data-scroll-reveal>EDIP</h2><div class="feature-layout"><div data-scroll-reveal data-motion-scale><ProductVisual visual={edip.visual} /></div><div class="feature-copy" data-scroll-reveal data-motion-lag=".04"><p class="lead">An AI-oriented video editor for creators.</p><p>Bring raw footage, describe the result you want, inspect the edit, and revise it conversationally. EDIP keeps source media and project ownership local while treating every edit as a controlled, non-destructive step. The goal is not to turn editing into a black box. You should be able to understand what changed, ask for another direction, and keep moving without rebuilding the whole timeline by hand.</p><ul class="tags">{edip.tags.map((tag)=><li>{tag}</li>)}</ul><p class="label">{edip.attribution}</p><div class="actions"><a class="text-link" href="/products/edip/">Explore EDIP <span class="arrow" aria-hidden="true">→</span></a><a class="text-link" href="/engineering/#media">Engineering decisions <span class="arrow" aria-hidden="true">→</span></a></div></div></div></section>
  <section id="devonair" class="section container collaboration" data-section-anchor><div data-scroll-reveal><p class="label">Devonair products</p><h2>Software, products & systems.</h2></div><div data-scroll-reveal><p>I also build as part of Devonair, the software, products, and systems side of Ebiren. Shared products stay explicitly shared; collaboration does not erase ownership.</p><ExternalLink class="text-link" href="https://devonair.dev/">Visit Devonair</ExternalLink></div></section>
  <section id="its-so-over" class="section container over-feature" data-section-anchor aria-labelledby="over-title"><div class="feature-meta" data-scroll-reveal><p class="label">Devonair / Shared product / In development</p><StatusTag ownership={over.ownership} status={over.status} /></div><div class="over-layout"><div class="iso-visual" data-scroll-reveal data-motion-scale><ProductVisual visual={over.visual}/></div><div data-scroll-reveal><h2 id="over-title">IT’S SO<br />OVER</h2><p class="lead">Local-only behavioral reality checks.</p><p>IT’S SO OVER is a local-only Android product built around behavioral reality checks. A constrained set of permissioned device signals is turned into on-device behavioral context, then used to decide whether a timely nudge is worth making and which curated message actually fits the moment.</p><p>Its tone is deliberately dry and sharp. It makes the behavior visible without pretending to know more about the person than the device can actually support.</p><p class="label">Built by Mehmet Arslanca and Murat Bahadır Kayıhan.</p><ul class="tags">{over.tags.map((tag)=><li>{tag}</li>)}</ul><ExternalLink class="text-link" href="https://devonair.dev/">View on Devonair</ExternalLink></div></div></section>
  <section id="ecosystem" class="section container ecosystem" data-section-anchor><div class="section-title" data-scroll-reveal><p class="label">Broader ecosystem</p><h2>Devonair.</h2></div><div class="small-products"><article data-scroll-reveal><h3>Aelova</h3><p>A Murat-led product now within Devonair’s product ecosystem.</p><ExternalLink class="text-link" href="https://kayihan.dev/">Visit Murat’s site</ExternalLink></article><article data-scroll-reveal data-motion-lag=".04"><h3>Ripple</h3><p>A Murat-led product now within Devonair’s product ecosystem.</p><ExternalLink class="text-link" href="https://kayihan.dev/">Visit Murat’s site</ExternalLink></article></div></section>
  <section id="orchestrai" class="section container postmortem" data-section-anchor aria-labelledby="orchestrai-title"><div class="section-title" data-scroll-reveal><p class="label">An honest postmortem</p><h2>Not everything survives.</h2></div><article><div data-scroll-reveal><StatusTag ownership={orchestrai.ownership} status={orchestrai.status}/><h3 id="orchestrai-title">OrchestrAI</h3><p class="lead">This one didn’t make it.</p></div><div data-scroll-reveal data-motion-lag=".04"><p>{orchestrai.description}</p><p>Its backend was treated seriously, but the reason to keep building it weakened. Archiving it was the point where the product decision became clearer than the implementation momentum.</p></div><div class="footprint" data-scroll-reveal><p class="label">Technical footprint</p><ul class="tags">{[...orchestrai.tags,'LLM / provider orchestration'].map((tag)=><li>{tag}</li>)}</ul></div></article></section>
  <section id="experiments" class="section container experiments" data-section-anchor><div class="section-title" data-scroll-reveal><p class="label">Experiments / earlier work</p><h2>Kept in context.</h2></div>{experiments.map((project,index)=><article data-scroll-reveal data-motion-lag={String(index*.03)}><div><h3>{project.name}</h3><StatusTag ownership={project.ownership} status={project.status}/></div><div><p>{project.description}</p><p class="label">{project.tags.join(' / ')}</p></div></article>)}</section>
</BaseLayout>
<style>
  .section-lead{display:grid;grid-template-columns:.5fr 1.5fr;gap:4rem}.section-lead h2,.section-title h2,.collaboration h2{font-size:clamp(3rem,7vw,7rem);line-height:.95}.feature-meta{display:flex;justify-content:space-between;gap:2rem}.product-feature>h2{font-size:clamp(6rem,18vw,18rem);line-height:.75;letter-spacing:-.08em;margin:clamp(4rem,7vw,7rem) 0}.feature-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(3rem,7vw,8rem);align-items:center}.feature-copy,.over-layout>div:last-child{color:var(--text-muted)}.lead{font-family:var(--font-display);font-size:clamp(1.8rem,3vw,3rem);color:var(--text)}.tags{list-style:none;padding:0;margin:2rem 0;display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;font-family:var(--font-mono);font-size:.68rem}.actions{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin-top:2rem}.collaboration{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,9vw,10rem);align-items:end}.collaboration>div:last-child{max-width:55ch;color:var(--text-muted)}.over-layout{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(3rem,7vw,7rem);align-items:center}.iso-visual{width:100%}.over-layout h2{font-size:clamp(4rem,9vw,9rem);line-height:.8;letter-spacing:-.07em}.ecosystem,.experiments{display:grid;grid-template-columns:.75fr 1.25fr;gap:4rem 8rem}.small-products{display:grid;grid-template-columns:1fr 1fr;gap:4rem}.small-products h3,.experiments h3{font-size:2rem}.small-products p,.experiments article>div:last-child,.postmortem article>div:nth-child(2){color:var(--text-muted)}.postmortem article{margin-top:5rem;padding:clamp(2rem,5vw,5rem);background:var(--bg-elevated);display:grid;grid-template-columns:.9fr 1.1fr;gap:4rem}.postmortem h3{font-size:clamp(4rem,8vw,8rem);line-height:.8;margin:2rem 0}.footprint{grid-column:1/-1}.experiments article{grid-column:2;display:grid;grid-template-columns:.5fr 1fr;gap:3rem;padding-block:2.5rem}
  @media(max-width:900px){.feature-layout,.over-layout,.collaboration,.ecosystem,.experiments,.postmortem article{grid-template-columns:1fr}.small-products{grid-template-columns:1fr}.experiments article,.footprint{grid-column:auto}}@media(max-width:600px){.section-lead{grid-template-columns:1fr}.experiments article{grid-template-columns:1fr}.feature-meta{align-items:flex-start;flex-direction:column}}
</style>
